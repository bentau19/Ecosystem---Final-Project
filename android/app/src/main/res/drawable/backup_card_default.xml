<?xml version="1.0" encoding="utf-8"?>
<!-- Default (unselected) state for a backup mode card.
     Switched at runtime to backup_card_selected via setBackground(). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface_card" />
    <stroke
        android:width="1dp"
        android:color="@color/stroke_card" />
    <corners android:radius="18dp" />
</shape>
