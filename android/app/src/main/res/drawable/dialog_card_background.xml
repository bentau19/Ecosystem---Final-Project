<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded dark card used as the background for custom dialogs (the dialog window itself is
     made transparent so these corners show). Subtle cyan-tinted border to match SyncDose. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/surface_card" />
    <stroke
        android:width="1dp"
        android:color="#402196F3" />
    <corners android:radius="20dp" />
</shape>
