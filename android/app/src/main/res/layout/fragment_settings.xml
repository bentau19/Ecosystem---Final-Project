<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <!-- ── Top bar ────────────────────────────────────────────────────────── -->
    <!--
        Mirrors fragment_backup.xml exactly:
          - Back button: 48×48dp minimum touch target, start=8dp, top=40dp
          - Title: 0dp-width constraint so it fills between the back btn and
            the invisible right spacer — this is what keeps it visually centred
            even though it's technically left-of-centre on the constraint chain.
          - Spacer: invisible 48×48dp view on the right to balance the title.
    -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings_back_desc"
        android:padding="12dp"
        android:scaleX="-1"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/text_primary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/spacerRight"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Invisible right-side spacer balances the back button so the title is centred -->
    <View
        android:id="@+id/spacerRight"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- ── Scrollable body ────────────────────────────────────────────────── -->

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <!-- ══════════════════ SECTION: APP ══════════════════════════════ -->

            <TextView
                android:id="@+id/tvSectionApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_app"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!--
                APP card — single row: Launch on startup toggle.
                Root LinearLayout uses backup_card_default (dark surface + stroke_card border).
            -->
            <LinearLayout
                android:id="@+id/cardApp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/backup_card_default"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionApp">

                <!--
                    Icon: power/startup symbol.
                    Marked importantForAccessibility="no" — the switch and its
                    contentDescription already cover the full accessible label.
                -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="20dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_launch"
                    app:tint="@color/icon_blue" />

                <!-- Title + subtitle — weight=1 pushes the switch to the right edge -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_auto_launch_title"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_auto_launch_sub"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <!--
                    SwitchCompat:
                    - thumbTint accent_cyan / trackTint stroke_card matches all other switches.
                    - minWidth="48dp" guarantees a 48dp touch target width.
                    - contentDescription is the accessible label; TalkBack appends "on"/"off".
                -->
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoLaunch"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="16dp"
                    android:checked="false"
                    android:contentDescription="@string/settings_auto_launch_desc"
                    android:minWidth="48dp"
                    app:thumbTint="@color/accent_cyan"
                    app:trackTint="@color/stroke_card" />

            </LinearLayout>

            <!-- ══════════════════ SECTION: TOOLS ════════════════════════════ -->

            <TextView
                android:id="@+id/tvSectionTools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:letterSpacing="0.12"
                android:text="@string/settings_section_tools"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardApp" />

            <!--
                TOOLS card — three rows: Virtual Drive, Clipboard Sync, Camera Mirror.

                Each row uses the same structure: icon / text-block(weight=1) / SwitchCompat.
                Rows are separated by a 1dp horizontal divider tinted @color/stroke_card,
                matching the pattern used by the Backup options card.

                The outer LinearLayout uses orientation="vertical" so rows stack naturally.
                Each row LinearLayout is orientation="horizontal" with gravity="center_vertical".
                minHeight="64dp" on each row guarantees the 48dp touch target for the switch
                even on small fonts (the visible row is taller than the switch itself).
            -->
            <LinearLayout
                android:id="@+id/cardTools"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/backup_card_default"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionTools">

                <!-- ── Row 1: File Backup ─────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <!-- Backup icon — decorative, excluded from TalkBack focus -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_backup"
                        app:tint="@color/icon_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_backup_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_backup_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBackup"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:checked="true"
                        android:contentDescription="@string/settings_backup_desc"
                        android:minWidth="48dp"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/stroke_card" />
                </LinearLayout>

                <!-- ── Divider ────────────────────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_card" />

                <!-- ── Row 2: Virtual Drive ────────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <!-- Folder icon — decorative, excluded from TalkBack focus -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_folder"
                        app:tint="@color/icon_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_virtual_drive_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_virtual_drive_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchVirtualDrive"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:checked="false"
                        android:contentDescription="@string/settings_virtual_drive_desc"
                        android:minWidth="48dp"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/stroke_card" />
                </LinearLayout>

                <!-- ── Divider ────────────────────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_card" />

                <!-- ── Row 2: Clipboard Sync ───────────────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <!-- Clipboard icon — decorative, excluded from TalkBack focus -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_clipboard"
                        app:tint="@color/icon_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_clipboard_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_clipboard_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchClipboardSync"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:checked="true"
                        android:contentDescription="@string/settings_clipboard_desc"
                        android:minWidth="48dp"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/stroke_card" />
                </LinearLayout>

                <!-- ── Divider ────────────────────────────────────────────── -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/stroke_card" />

                <!-- ── Row 3: Camera Mirror (Webcam) ──────────────────────── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="64dp"
                    android:orientation="horizontal">

                    <!-- Camera icon — decorative, excluded from TalkBack focus -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="20dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/icon_blue" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_webcam_title"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/settings_webcam_sub"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchWebcam"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="16dp"
                        android:checked="true"
                        android:contentDescription="@string/settings_webcam_desc"
                        android:minWidth="48dp"
                        app:thumbTint="@color/accent_cyan"
                        app:trackTint="@color/stroke_card" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
