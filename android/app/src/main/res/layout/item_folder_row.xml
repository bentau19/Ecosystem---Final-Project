<?xml version="1.0" encoding="utf-8"?>
<!--
    Single row in the FolderPickerFragment's directory list.
    Minimum 52dp height satisfies the 48dp touch-target requirement.
    The chevron is hidden for the "↑ .." up-navigation row (handled in adapter).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">

    <!-- Folder / up-arrow icon -->
    <ImageView
        android:id="@+id/ivRowIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_folder"
        app:tint="@color/icon_blue" />

    <!-- Folder name or "↑  .." label -->
    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

    <!-- Trailing chevron — hidden for "↑ .." row -->
    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/text_muted" />

</LinearLayout>
