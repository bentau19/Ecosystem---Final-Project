<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom "PC found" dialog shown after a TauSync PC is discovered over BLE.
  Styled to match SyncDose (dark rounded card, accent icon circle, primary + neutral buttons).
  Inflated by ConnectFragment.showPcFoundDialog and set as the AlertDialog's view; the dialog
  window background is made transparent so the rounded card corners show.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@drawable/dialog_card_background"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="22dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/icon_circle_cyan">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_laptop"
            android:contentDescription="PC"
            app:tint="@color/accent_cyan"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="PC found"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dlgPcName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        tools:text="SyncDose-PC"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/dlgPcMac"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="CC:47:40:5D:67:05"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Connect over Bluetooth?"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dlgConnect"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="22dp"
        android:background="@drawable/button_shape"
        android:backgroundTint="@color/accent_cyan"
        android:text="Connect"
        android:textAllCaps="false"
        android:textColor="@color/accent_button_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/dlgCancel"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="15sp" />

</LinearLayout>
