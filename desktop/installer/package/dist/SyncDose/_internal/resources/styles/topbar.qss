Topbar {
    background: #0D1117;
}

Topbar QWidget {
    background: transparent;
}

#titleLabel {
    color: #F1F5F9;
    font-size: 25px;
    font-family: "'Segoe UI', sans-serif";
    font-weight: 700;
}

#subtitleLabel {
    color: #64748B;
    font-size: 14px;
    font-family: "'Segoe UI', sans-serif";

}

#disconnectButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #7F1D1D, stop:1 #991B1B);
    border: 1px solid #DC2626;
    border-radius: 8px;
    color: #FCA5A5;
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

#disconnectButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #991B1B, stop:1 #B91C1C);
}

#disconnectButton:pressed {
    background: #7F1D1D;
}
