#LeftPanel {
    background-color: #0d1117;
    border-right: 1px solid #1e2530;
}

#LeftPanel QWidget {
    background-color: transparent;
}

#DescriptionLabel {
    color: #6e7681;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 400;
}
#LogoName {
    font-size: 25px;
    font-weight: 800;
}

#QR {
    background-color: #ffffff;
    border-radius: 24px;
    border: 2px solid rgba(34, 211, 238, 0.25);
}
#GenericScanInstructions {
    color: #c9d1d9;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 15px;
    font-weight: 600;
}

#DetailedScanInstructions {
    color: #6e7681;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}


#RefreshButton {
    color: #00d4aa;
    background-color: rgba(0, 212, 170, 18);
    border: 1px solid rgba(0, 212, 170, 55);
    border-radius: 8px;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 0px 14px;
}

#RefreshButton:hover {
    background-color: rgba(0, 212, 170, 35);
    border-color: rgba(0, 212, 170, 90);
    color: #00ffcc;
}

#RefreshButton:pressed {
    background-color: rgba(0, 212, 170, 50);
    color: #009980;
}

#WaitingForConnectionLabel {
    color: #6e7681;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}
