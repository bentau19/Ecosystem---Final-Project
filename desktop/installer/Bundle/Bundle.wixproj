<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <AcceptEula>wix7</AcceptEula>
    <OutputName>SyncDoseSetup</OutputName>
    <OutputType>Bundle</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="7.0.0" />
  </ItemGroup>

  <!-- Reference your Package project so it builds first -->
  <ItemGroup>
    <ProjectReference Include="..\Package\Package.wixproj" />
  </ItemGroup>
</Project>