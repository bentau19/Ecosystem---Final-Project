<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
      xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="SyncDose"
          Version="1.0.0.0"
          Manufacturer="YourName"
          UpgradeCode="a6a1933c-32d8-4b05-b46b-9b80fd8dd621">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkLicense" />
    </BootstrapperApplication>


<util:RegistrySearch Id="AspNetCore10Check"
                     Root="HKLM"
                     Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.AspNetCore.App"
                     Value="10.0"
                     Result="exists"
                     Variable="AspNetCore10Installed" />

    <Chain>

      <!-- Install .NET runtime if missing -->
 <ExePackage Id="AspNetCore10Runtime"
            InstallArguments="/install /quiet /norestart"
            RepairArguments="/repair /quiet /norestart"
            UninstallArguments="/uninstall /quiet /norestart"
            DetectCondition="AspNetCore10Installed"
            Vital="yes">

    <ExePackagePayload
    Name="aspnetcore-runtime-10.0.8-win-x64.exe"
        DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/aspnetcore/Runtime/10.0.8/aspnetcore-runtime-10.0.8-win-x64.exe"
        Size="11285744"
        Compressed="no"
        Hash="a8209d7bf770a69d8ba4643f903cd425636253d73d0ecabe6f4a4ff2870fbe619f252f5fa27b8e8f6f31b65a4495e55e4511f2fc4e40c7d867a9ee618844af86"
        Version="10.0.8"
        ProductName="Microsoft ASP.NET Core 10.0.8 Runtime" />
</ExePackage>

      <!-- Your MSI -->
      <MsiPackage SourceFile="..\Package\bin\Release\Package.msi"
                  Vital="yes" />

    </Chain>
  </Bundle>
</Wix>