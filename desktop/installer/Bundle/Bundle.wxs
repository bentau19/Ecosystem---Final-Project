<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="SyncDose"
          Version="1.0.0.0"
          Manufacturer="SyncDose"
          UpgradeCode="a6a1933c-32d8-4b05-b46b-9b80fd8dd621">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkLicense" />
    </BootstrapperApplication>

    <!--
      Prerequisite detection. These searches run before the Chain and set Burn
      variables consumed by each package's DetectCondition. When a DetectCondition
      is true, Burn treats that package as already present and skips it.
    -->

    <!-- .NET 8 x64 runtime: detect by the on-disk shared-framework folder, which is
         the authoritative source. (The Uninstall registry subkey is a GUID, and the
         'dotnet\Setup\InstalledVersions\...\sharedfx' registry layout varies by
         installer build, so neither is reliable.) Pinned to the bundled 8.0.16; if a
         different 8.0.x is present but not this exact one, the .NET installer itself
         no-ops, so it is a safe backstop. -->
    <util:FileSearch Id="SearchDotNet8"
                     Variable="DotNetFound"
                     Path="[ProgramFiles64Folder]dotnet\shared\Microsoft.NETCore.App\8.0.16\System.Private.CoreLib.dll"
                     Result="exists" />

    <!-- OBS Studio: the OBS installer is NSIS, which registers its uninstall info
         under the product-name subkey 'OBS Studio' (NOT the Inno-style
         '<AppId>_is1'). The NSIS installer is a 32-bit process, so on 64-bit
         Windows the key lands in the WOW6432Node (32-bit) view — Bitness must be
         always32 or the search reads the wrong hive and never matches. -->
    <util:RegistrySearch Id="SearchObsStudio"
                         Variable="ObsFound"
                         Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\OBS Studio"
                         Value="DisplayName"
                         Result="exists"
                         Bitness="always32" />

    <!--
      OFFLINE INSTALLER.
      Every package below uses a local SourceFile and NO DownloadUrl, so WiX
      embeds the payload directly inside SyncDoseSetup.exe. The end user gets a
      single self-contained .exe that installs with no internet connection.

      The two prerequisite files (.NET runtime + WinFSP) are not in the repo;
      the CI "Download bundle prerequisites" step fetches them into this folder
      before `dotnet build` so they can be embedded.
    -->
    <Chain>

      <!-- .NET 8 x64 Runtime (required by the TauSync C# library via pythonnet).
           Permanent + no UninstallArguments => Burn never removes the shared
           runtime on uninstall (other apps may depend on it). DetectCondition
           (DotNetFound, set by SearchDotNet8) skips installation if already
           present. The .NET installer is idempotent, but this improves UX by
           avoiding unnecessary reinstalls. -->
      <ExePackage Id="DotNet8Runtime"
                  SourceFile="dotnet-runtime-8.0.16-win-x64.exe"
                  InstallArguments="/install /quiet /norestart"
                  Permanent="yes"
                  Vital="yes"
                  DetectCondition="DotNetFound" />

      <!-- WinFSP (required for the Virtual Drive feature via VirtualDrive.exe).
           MsiPackage auto-detects via the MSI ProductCode captured at build
           time, so it is skipped automatically if already installed — no
           DetectCondition needed (unlike the ExePackages above).
           Permanent="yes" because WinFSP is a shared library that other apps
           might depend on; removing it when SyncDose uninstalls could break
           those apps. -->
      <MsiPackage Id="WinFspMsi"
                  SourceFile="winfsp-2.0.23075.msi"
                  Permanent="yes"
                  Vital="yes" />

      <!-- OBS Studio with Virtual Camera plugin (required for phone camera streaming).
           DetectCondition (ObsFound, set by SearchObsStudio) skips install if already
           present. Permanent="no" means OBS is removed when SyncDose uninstalls.
           Vital="no" allows SyncDose to install even if OBS fails (user can fix manually).
           OBS appears in Add/Remove Programs so users can see it's installed. -->
      <ExePackage Id="ObsStudio"
                  SourceFile="OBS-Studio-32.1.2-Windows-x64-Installer.exe"
                  InstallArguments="/S /D=C:\Program Files\obs-studio"
                  Permanent="yes"
                  Vital="no"
                  DetectCondition="ObsFound" />

      <!-- Main SyncDose application installer (Package.msi, built earlier in CI). -->
      <MsiPackage SourceFile="..\Package\bin\Release\Package.msi"
                  Vital="yes" />

    </Chain>
  </Bundle>
</Wix>
