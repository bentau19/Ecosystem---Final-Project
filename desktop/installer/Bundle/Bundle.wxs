<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
      xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="SyncDose"
          Version="1.0.0.0"
          Manufacturer="YourName"
          UpgradeCode="a6a1933c-32d8-4b05-b46b-9b80fd8dd621">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
        LicenseUrl=""
        Theme="hyperlinkLicense" />
    </BootstrapperApplication>




<util:RegistrySearch Id="DotNet8Check"
                     Root="HKLM"
                     Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.NETCore.App"
                     Value="8.0"
                     Result="exists"
                     Variable="DotNet8Installed" />

    <Chain>

      <!-- Install .NET 8 Runtime if missing (required by TauSync C# library via pythonnet) -->
      <ExePackage Id="DotNet8Runtime"
                  InstallArguments="/install /quiet /norestart"
                  RepairArguments="/repair /quiet /norestart"
                  UninstallArguments="/uninstall /quiet /norestart"
                  DetectCondition="DotNet8Installed"
                  Vital="yes">

        <ExePackagePayload
            Name="dotnet-runtime-8.0.16-win-x64.exe"
            DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/Runtime/8.0.16/dotnet-runtime-8.0.16-win-x64.exe"
            Size="29032704"
            Compressed="no"
            Hash="TODO_REPLACE_WITH_SHA512_OF_dotnet-runtime-8.0.16-win-x64.exe"
            Version="8.0.16"
            ProductName="Microsoft .NET Runtime 8.0.16" />
      </ExePackage>

      <!-- Your MSI -->
      <MsiPackage SourceFile="..\Package\bin\Release\Package.msi"
                  Vital="yes" />

    </Chain>
  </Bundle>
</Wix>