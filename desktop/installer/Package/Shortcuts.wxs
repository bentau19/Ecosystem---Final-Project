<?xml version="1.0" encoding="utf-8"?>
<!--
    Shortcuts.wxs — SyncDose Installer (WiX v7)
    ============================================
    Creates:
      - Desktop shortcut      → SyncDose.exe
      - Start Menu shortcut   → SyncDose.exe
    Removes Start Menu folder on uninstall.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>

    <ComponentGroup Id="SyncDoseShortcuts" Directory="INSTALLFOLDER">
      <Component Id="SyncDoseShortcutComponent" Guid="899925c8-cc6a-4501-b763-faf1a2947219">

        <!-- Desktop shortcut -->
        <Shortcut
          Id="SyncDoseDesktopShortcut"
          Directory="DesktopFolder"
          Name="SyncDose"
          Description="SyncDose — Cross-device connectivity"
          Target="[INSTALLFOLDER]SyncDose.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="SyncDoseIcon" />

        <!-- Start Menu shortcut -->
        <Shortcut
          Id="SyncDoseStartMenuShortcut"
          Directory="SyncDoseStartMenuFolder"
          Name="SyncDose"
          Description="SyncDose — Cross-device connectivity"
          Target="[INSTALLFOLDER]SyncDose.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="SyncDoseIcon" />

        <!--
            Explicitly delete both .lnk files on uninstall.  This is the actual
            fix for the desktop icon that was left behind: Windows Installer does
            NOT reliably remove *non-advertised* shortcuts when their component is
            uninstalled (a long-standing MSI quirk), so the Shortcut rows above
            are not enough on their own.  Removing the Start-Menu .lnk here also
            lets the RemoveFolder below succeed, since a folder is only deleted
            once it is empty.
        -->
        <RemoveFile
          Id="RemoveSyncDoseDesktopShortcut"
          Directory="DesktopFolder"
          Name="SyncDose.lnk"
          On="uninstall" />
        <RemoveFile
          Id="RemoveSyncDoseStartMenuShortcut"
          Directory="SyncDoseStartMenuFolder"
          Name="SyncDose.lnk"
          On="uninstall" />

        <!-- Remove the Start Menu folder on uninstall -->
        <RemoveFolder
          Id="RemoveSyncDoseStartMenuFolder"
          Directory="SyncDoseStartMenuFolder"
          On="uninstall" />

        <!--
            Registry key — required as KeyPath for shortcut components.
            Tracks this component for clean install/repair/uninstall.

            Stays HKCU (per-user): the shortcuts live in DesktopFolder /
            ProgramMenuFolder, which Windows Installer classifies as per-user
            data.  The keypath must match that scope, so an HKLM/HKMU keypath
            triggers ICE57 ("per-user data + per-machine/ambiguous keypath").
            Reliable removal is handled by the RemoveFile rows above, not the
            keypath.
        -->
        <RegistryValue
          Root="HKCU"
          Key="Software\SyncDose"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />

      </Component>
    </ComponentGroup>

    <!--
        App icon — WiX extracts it from SyncDose.exe's embedded icon.
        If you have a standalone icon.ico, use SourceFile="icon.ico" instead.
    -->
    <Icon Id="SyncDoseIcon" SourceFile="../../resources/icons/logo.ico" />

  </Fragment>
</Wix>
