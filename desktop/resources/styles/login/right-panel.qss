/* ── Right Panel container ─────────────────────────── */
#RightPanel {
    background-color: {{SURFACE_SECONDARY}};
    border-left: 1px solid {{BORDER_DEFAULT}};
}

#RightPanel QWidget {
    background-color: transparent;
}

/* ── Header ────────────────────────────────────────── */
#RightPanelTitle {
    color: {{TEXT_PRIMARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 22px;
    font-weight: 700;
}

#RightPanelSubtitle {
    color: {{TEXT_SECONDARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 400;
    padding-bottom: 16px;
    border-bottom: 1px solid {{BORDER_DEFAULT}};
}

/* ── Device card ───────────────────────────────────── */
#DeviceCard {
    background-color: {{CARD_BG}};
    border: 1px solid {{CARD_BORDER}};
    border-radius: 12px;
}

#DeviceCard:hover {
    background-color: {{CARD_HOVER_BG}};
    border-color: {{ACCENT_PRIMARY}};
}

#DeviceName {
    color: {{TEXT_PRIMARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 15px;
    font-weight: 600;
}

#DeviceMeta {
    color: {{TEXT_SECONDARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}

#DeviceTime {
    color: {{TEXT_FAINT}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 11px;
}

/* ── Status badges ─────────────────────────────────── */
#BadgeRecent {
    color: {{ACCENT_PRIMARY}};
    background-color: rgba(34, 211, 238, 20);
    border: 1px solid rgba(34, 211, 238, 60);
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}

#BadgeIdle {
    color: {{TEXT_FAINT}};
    background-color: rgba(74, 85, 104, 20);
    border: 1px solid rgba(74, 85, 104, 60);
    border-radius: 6px;
    padding: 2px 8px;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}

/* ── Hover connect button ──────────────────────────── */
#ConnectBtn {
    color: {{ACCENT_PRIMARY}};
    background-color: rgba(34, 211, 238, 15);
    border: 1px solid rgba(34, 211, 238, 60);
    border-radius: 8px;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 16px;
    min-width: 90px;
}

#ConnectBtn:hover {
    background-color: rgba(34, 211, 238, 30);
    border-color: rgba(34, 211, 238, 120);
    color: {{ACCENT_HOVER}};
}

#ConnectBtn:pressed {
    background-color: rgba(34, 211, 238, 50);
}

/* ── Empty state ───────────────────────────────────── */
#EmptyStateTitle {
    color: {{TEXT_SECONDARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 15px;
    font-weight: 600;
}

#EmptyStateSubtitle {
    color: {{TEXT_FOOTER}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}

/* ── Footer ────────────────────────────────────────── */
#FooterText {
    color: {{TEXT_FOOTER}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 11px;
}

#FooterLink {
    color: {{TEXT_FAINT}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 11px;
}

#FooterLink:hover {
    color: {{ACCENT_PRIMARY}};
}
