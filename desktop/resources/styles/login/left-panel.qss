#LeftPanel {
    background-color: {{LEFT_PANEL_BG}};
    border-right: 1px solid {{LEFT_PANEL_BORDER}};
}

#LeftPanel QWidget {
    background-color: transparent;
}

#DescriptionLabel {
    color: {{TEXT_MUTED}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 400;
}

#LogoName {
    font-size: 25px;
    font-weight: 800;
}

/* QR code always needs a pure white background to be scannable */
#QR {
    
    background-color: #ffffff;
    border-radius: 24px;
    border: 2px solid rgba(34, 211, 238, 0.25);
}

#GenericScanInstructions {
    color: {{TEXT_TERTIARY}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 15px;
    font-weight: 600;
}

#DetailedScanInstructions {
    color: {{TEXT_MUTED}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}

#RefreshButton {
    color: {{ACCENT_TEAL}};
    background-color: rgba(0, 212, 170, 18);
    border: 1px solid rgba(0, 212, 170, 55);
    border-radius: 8px;
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
    padding: 0px 14px;
}

#RefreshButton:hover {
    background-color: rgba(0, 212, 170, 35);
    border-color: rgba(0, 212, 170, 90);
    color: {{ACCENT_TEAL_HOVER}};
}

#RefreshButton:pressed {
    background-color: rgba(0, 212, 170, 50);
    color: {{ACCENT_TEAL_PRESSED}};
}

#WaitingForConnectionLabel {
    color: {{TEXT_MUTED}};
    font-family: "SF Pro Text", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
}
