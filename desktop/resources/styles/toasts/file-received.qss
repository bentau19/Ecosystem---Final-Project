/* ── File-received toast notification ─────────────────────────────────────────
   Single-row banner:
     [↓]  File Received  ·  filename.pdf   [Download file]  [Cancel download]

   Tokens resolved via FileReceivedToastColors:
     {{BACKGROUND}}          — elevated card surface
     {{BORDER}}              — card border
     {{TITLE}}               — primary heading text
     {{FILENAME}}            — secondary muted filename + separator text
     {{ICON_BG}}             — icon circle background (deep cyan tint)
     {{ICON_BORDER}}         — icon circle border (mid cyan tint)
     {{ICON_COLOR}}          — icon character color (cyan accent)
     {{DOWNLOAD_BTN}}        — primary action text (default)
     {{DOWNLOAD_BTN_HOVER}}  — primary action text (hover)
     {{CANCEL_BTN}}          — neutral secondary text (default)
     {{CANCEL_BTN_HOVER}}    — neutral secondary text (hover)
   ─────────────────────────────────────────────────────────────────────────── */

/* Toast banner container */
QWidget#FileReceivedToast {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 12px;
}

/* Icon circle */
QLabel#IconCircle {
    background-color: {{ICON_BG}};
    border: 1px solid {{ICON_BORDER}};
    border-radius: 16px;
    color: {{ICON_COLOR}};
    font-size: 14px;
    font-weight: 700;
}

/* "File Received" heading */
QLabel#TitleLabel {
    color: {{TITLE}};
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

/* Mid-dot separator between title and filename */
QLabel#SeparatorDot {
    color: {{FILENAME}};
    font-size: 13px;
    background: transparent;
}

/* Filename — muted, clips at max-width set in Python */
QLabel#FilenameLabel {
    color: {{FILENAME}};
    font-size: 13px;
    background: transparent;
}

/* ── Action buttons — text-link style, no chrome ────────────────────────── */

QPushButton#DownloadButton {
    background: transparent;
    border: none;
    color: {{DOWNLOAD_BTN}};
    font-size: 12px;
    font-weight: 600;
    padding: 0px 4px;
    outline: none;
}

QPushButton#DownloadButton:hover {
    color: {{DOWNLOAD_BTN_HOVER}};
}

QPushButton#DownloadButton:pressed {
    color: {{DOWNLOAD_BTN}};
}

QPushButton#CancelButton {
    background: transparent;
    border: none;
    color: {{CANCEL_BTN}};
    font-size: 12px;
    font-weight: 500;
    padding: 0px 4px;
    outline: none;
}

QPushButton#CancelButton:hover {
    color: {{CANCEL_BTN_HOVER}};
}

QPushButton#CancelButton:pressed {
    color: {{CANCEL_BTN}};
}
