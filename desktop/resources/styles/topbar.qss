Topbar {
    background: {{BACKGROUND}};
}

Topbar QWidget {
    background: transparent;
}

#titleLabel {
    color: {{TITLE_COLOR}};
    font-size: 25px;
    font-family: "'Segoe UI', sans-serif";
    font-weight: 700;
}

#subtitleLabel {
    color: {{SUBTITLE_COLOR}};
    font-size: 14px;
    font-family: "'Segoe UI', sans-serif";
}

#disconnectButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 {{BTN_BG_0}}, stop:1 {{BTN_BG_1}});
    border: 1px solid {{BTN_BORDER}};
    border-radius: 8px;
    color: {{BTN_COLOR}};
    font-size: 13px;
    font-weight: 600;
    padding: 0 18px;
}

#disconnectButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 {{BTN_HOVER_0}}, stop:1 {{BTN_HOVER_1}});
}

#disconnectButton:pressed {
    background: {{BTN_PRESSED}};
}
