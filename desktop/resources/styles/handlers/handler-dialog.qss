/* ── File-handler notification dialog ─────────────────────────────────────────
   Static tokens resolved via HandlerDialogColors:
     {{BACKGROUND}}       — dialog body surface
     {{BORDER}}           — dialog border + dismiss button border
     {{TEXT_PRIMARY}}     — heading color
     {{TEXT_SECONDARY}}   — body text + dismiss button text
     {{BTN_GRADIENT_END}} — Try Again gradient end (sky-600, #0891b2)

   Dynamic per-dialog tokens injected by _BaseHandlerDialog._apply_style():
     {{ACCENT}}       — solid hex accent  (icon text, gradient start)
     {{ICON_BG}}      — icon circle bg    (rgba, ~10 % opacity)
     {{ICON_BORDER}}  — icon circle border(rgba, ~30 % opacity)
   ─────────────────────────────────────────────────────────────────────────── */

QDialog#HandlerDialog {
    background-color: {{BACKGROUND}};
    border: 1px solid {{BORDER}};
    border-radius: 12px;
}

/* Centered accent circle containing the icon character */
QLabel#IconCircle {
    background-color: {{ICON_BG}};
    border: 1px solid {{ICON_BORDER}};
    border-radius: 26px;
    color: {{ACCENT}};
    font-size: 22px;
    font-weight: 700;
}

/* Heading */
QLabel#TitleLabel {
    color: {{TEXT_PRIMARY}};
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    background: transparent;
}

/* Body copy */
QLabel#MessageLabel {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: transparent;
}

/* Try Again — primary gradient CTA */
QPushButton#TryAgainButton {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 {{ACCENT}},
        stop:1 {{BTN_GRADIENT_END}}
    );
    color: #ffffff;
    border: none;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    outline: none;
}

QPushButton#TryAgainButton:hover {
    /* Flatten to solid accent on hover — slightly lighter than the gradient */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 {{ACCENT}},
        stop:1 {{ACCENT}}
    );
}

QPushButton#TryAgainButton:pressed {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 {{BTN_GRADIENT_END}},
        stop:1 {{BTN_GRADIENT_END}}
    );
}

/* Dismiss — secondary neutral */
QPushButton#DismissButton {
    background-color: transparent;
    color: {{TEXT_SECONDARY}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
    outline: none;
}

QPushButton#DismissButton:hover {
    color: {{TEXT_PRIMARY}};
    border-color: {{ACCENT}};
}

QPushButton#DismissButton:pressed {
    background-color: transparent;
}
