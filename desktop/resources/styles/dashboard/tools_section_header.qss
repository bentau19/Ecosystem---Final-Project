#title {
    color: {{TEXT_PRIMARY}};
    font-size: 17px;
    font-weight: 700;
    background: transparent;
}

#tag {
    color: {{TEXT_SECONDARY}};
    font-size: 13px;
    background: {{TAG_BACKGROUND}};
    border-width: 1px;
    border-style: solid;
    border-color: {{BORDER_DEFAULT}};
    border-radius: 10px;
    padding: 3px 12px;
}
