#card {
    background: {{BACKGROUND}};
    border-color: {{BORDER}};
    border-style: solid;
    border-width: 1px;
    border-radius: 12px;
}

#card:hover {
    border-color: {{BORDER_HOVER}};
    border-style: solid;
    border-width: 1px;
}

#titleLabel {
    color: {{TITLE}};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 1.5px;
    background: transparent;
}

#icon {
    border-radius: 8px;
    font-size: 14px;
}

#content {
    background: transparent;
}

